# bench-vps/.env.example
# Скопируйте в .env и заполните значения
# Используется скриптами k6 и benchmark.yml

# ── Пути на сервере ───────────────────────────────────────────────────────────

# Корневая директория бенчмарка
BENCH_BASE_PATH=/opt/bench

# Директория для k6-скриптов (копируются из репозитория перед каждым прогоном)
BENCH_K6_PATH=/opt/bench/k6

# Директория для результатов (results.json, summary.json)
BENCH_RESULTS_PATH=/opt/bench/results

# ── k6 — дефолтные параметры нагрузки ────────────────────────────────────────
# Все значения можно переопределить через k6_env_flags в benchmark.yml

# landing.js — baseline-тест
K6_LANDING_RATE=20
K6_LANDING_DURATION=5m
K6_LANDING_PRE_ALLOCATED_VUS=20
K6_LANDING_MAX_VUS=200
K6_LANDING_SLEEP=0.2

# catalog.js — ramping stress-тест
K6_CATALOG_START_RATE=10
K6_CATALOG_PRE_ALLOCATED_VUS=50
K6_CATALOG_MAX_VUS=500
K6_CATALOG_STAGE1_TARGET=20
K6_CATALOG_STAGE1_DURATION=2m
K6_CATALOG_STAGE2_TARGET=50
K6_CATALOG_STAGE2_DURATION=3m
K6_CATALOG_STAGE3_TARGET=100
K6_CATALOG_STAGE3_DURATION=3m
K6_CATALOG_STAGE4_TARGET=150
K6_CATALOG_STAGE4_DURATION=2m
K6_CATALOG_STAGE5_TARGET=0
K6_CATALOG_STAGE5_DURATION=30s
K6_CATALOG_SLEEP=0.3

# stress.js — тест до отказа
K6_STRESS_START_RATE=10
K6_STRESS_MAX_VUS=1000
K6_STRESS_STEP_DURATION=1m
K6_STRESS_MAX_RATE=500

# ── Системный пользователь ────────────────────────────────────────────────────
BENCH_USER=bench
